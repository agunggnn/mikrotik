# Salin ke .env lalu isi. JANGAN commit .env ke git.
PORT=8999
BIND=127.0.0.1

# Path binary agy (default: ~/.local/bin/agy, fallback ke PATH)
#AGY_BIN=/home/agy/.local/bin/agy

# Lokasi conversation agy (default: ~/.gemini/antigravity-cli/brain)
#BRAIN_DIR=/home/agy/.gemini/antigravity-cli/brain

# Direktori data (devices.json + jobs/)
DATA_DIR=/opt/pc-bridge/data

# Root repo kerja — parameter "repo" di /api/vibe harus di dalamnya
WORK_ROOT=/home/agy/repos

# WAJIB. Generate: openssl rand -hex 32
BRIDGE_ADMIN_TOKEN=

# Timeout per job agy (ms). Default 900000 = 15 menit
#AGY_TIMEOUT_MS=900000

# Job concurrent maksimum (lindungi VPS kecil)
#MAX_CONCURRENT_JOBS=2

# Rate limit per device per menit
#RATE_LIMIT_PER_MIN=30
