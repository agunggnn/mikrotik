[Unit]
Description=pc-bridge - agy coding agent HTTP bridge
After=network.target

[Service]
Type=simple
User=agy
WorkingDirectory=/opt/pc-bridge
EnvironmentFile=/opt/pc-bridge/.env
ExecStart=/usr/bin/node /opt/pc-bridge/pc-bridge.mjs
Restart=always
RestartSec=5
# Hardening dasar
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
